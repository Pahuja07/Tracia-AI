# Required by the TRACIA pipeline
OPENAI_API_KEY=replace_with_your_openai_api_key

# Used by both the local Neo4j container and the pipeline.
NEO4J_PASSWORD=choose_a_strong_local_password

# Comma-separated frontend origins allowed to call the API.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Set true only if your network requires the configured HTTP(S) proxy for OpenAI.
OPENAI_USE_ENV_PROXY=false

# Chroma defaults to a local persistent database at artifacts/chroma. To use
# Chroma Cloud, set CHROMA_MODE=cloud and provide all three values below.
CHROMA_MODE=local
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=

# Uses isolated mock-case Chroma collections and never indexes incoming cases.
TRACIA_ENV=development
